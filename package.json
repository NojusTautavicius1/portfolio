{
  "name": "nojus-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "model:build": "\"C:/Program Files/Blender Foundation/Blender 5.3/blender.exe\" --background --factory-startup --python blender/zondas.py -- .",
